{
  "manifest_version": 3,
  "name": "Manemark",
  "version": "1.2.8",
  "description": "Save AI-extracted article text or raw webpage HTML locally; search saved Manemarks with MiniLM.",
  "action": {
    "default_icon": "assets/icon.png",
    "default_popup": "popup.html",
    "default_title": "Manemark - Save article content"
  },
  "icons": {
    "48": "assets/icon.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  }
}
